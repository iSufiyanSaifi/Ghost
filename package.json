{
  "name": "ghost",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ghost design system for Ghost Garage ERP: Radix + Tailwind v4 components themed with Ghost tokens.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
