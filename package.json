    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.1.0",
    "dequal": "2.0.3",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "0.474.0",
    "prism-react-renderer": "2.4.1",
    "radix-ui": "1.4.3",
    "react": "19.2.3",
